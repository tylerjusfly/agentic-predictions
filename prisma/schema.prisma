generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Premierleague {
  id                    Int       @id @default(autoincrement())
  game_id               String    @unique
  home_team             String
  away_team             String
  predicted_score       String
  predicted_winner      String?
  month                 String
  time                  String
  date                  String
  bts                   String?
  home_win_probability  String?
  away_win_probability  String?
  both_team_to_score    String?
  over_two_goals        String?
  over_three_goals      String?
  confidence_level      String?
  confidence            Float?
  reasoning             String?
  actual_score          String?
  created_at            DateTime? @default(now())
}

model Transactions {
  id            String    @id @default(cuid())
  email         String
  amount        String
  status        String
  reference     String
  payment_month String?
  created_at    DateTime? @default(now())
}

// Define an enum for the user roles
enum Role {
  ADMIN
  USER
}

model Users {
  id           String   @id @default(cuid())
  email        String   @unique
  passkey      String
  salt         String
  reference    String
  verified     Boolean  @default(false)
  subsribed_at String
  created_at   DateTime @default(now())
  roles        Role[]   @default([USER])
}

model PredictionStat {
  id                    Int      @id @default(autoincrement())
  month                 String
  league                String
  totalPredictions      Int

  correctScorePassed    Int
  correctScoreFailed    Int

  over15Passed          Int
  over15Failed          Int

  over25Passed          Int
  over25Failed          Int

  btsPassed             Int
  btsFailed             Int

  straightWinPassed     Int
  straightWinFailed     Int

  drawPassed            Int
  drawFailed            Int

  brierScore            Float?
  brierWinner           Float?
  brierBtts             Float?
  brierGoals            Float?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([month, league]) // ensure one record per month+league
}

model DriftSignal {
  id         Int      @id @default(autoincrement())
  league     String
  market     String
  month      String
  accuracy   Float
  threshold  Float
  window     Int
  createdAt  DateTime @default(now())

  @@index([league, market])
}

model AgentMemory {
  id          String   @id @default(uuid())
  league      String
  market      String
  month       String
  accuracy    Float
  brierScore  Float?
  sampleSize  Int?
  createdAt   DateTime @default(now())

  @@unique([league, market, month])
  @@index([league, market])
}

model PromptConfig {
  id                   Int      @id @default(autoincrement())
  league               String
  version              Int
  active               Boolean  @default(false)
  score_emphasis       String   @default("normal")
  winner_emphasis      String   @default("normal")
  btts_emphasis        String   @default("normal")
  goals_emphasis       String   @default("normal")
  score_temperature    Float?
  winner_temperature   Float?
  btts_temperature     Float?
  goals_temperature    Float?
  score_system_prompt  String   @db.Text
  winner_system_prompt String   @db.Text
  btts_system_prompt   String   @db.Text
  goals_system_prompt  String   @db.Text
  global_preamble      String   @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([league, version])
  @@index([league, active])
}
